# --- Database Configuration ---
DB_NAME=romm_db
DB_USER=romm-user
DB_PASSWD=romm-password
DB_HOST=romm-db
DB_PORT=3306

# --- MariaDB Service ---
MARIADB_DATABASE=romm_db
MARIADB_USER=romm-user
MARIADB_PASSWORD=romm-password
MARIADB_ROOT_PASSWORD=romm-root-password

# --- ROMM Authentication ---
# Generate a secure key for production
ROMM_AUTH_SECRET_KEY=yoursecret-key-change-this

# --- ROMM Paths ---
ROMM_LIBRARY_DIR=/romm/library
ROMM_RESOURCES_DIR=/romm/resources
ROMM_CONFIG_PATH=/romm/config/config.yml
HOST=0.0.0.0
PORT=666
